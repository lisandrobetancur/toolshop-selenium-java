# Copia este archivo a .env y completa los valores. Las variables de entorno reales
# tienen prioridad sobre el archivo .env.

# Aplicación bajo prueba
BASE_URL=https://practicesoftwaretesting.com
API_URL=https://api.practicesoftwaretesting.com

# Navegador: chrome | firefox | edge | safari (safari solo en macOS)
BROWSER=chrome
HEADLESS=true

# Selenium Grid (opcional). Si se define, se usa RemoteWebDriver contra esa URL.
# GRID_URL=http://localhost:4444

# Espera explícita máxima por condición, en segundos
TIMEOUT_SECONDS=15

# Hilos de ejecución en paralelo
PARALLELISM=4

# Cuenta de administrador. Los valores por defecto están publicados en el README de
# https://github.com/testsmith-io/practice-software-testing ("Default accounts").
ADMIN_EMAIL=admin@practicesoftwaretesting.com
ADMIN_PASSWORD=
